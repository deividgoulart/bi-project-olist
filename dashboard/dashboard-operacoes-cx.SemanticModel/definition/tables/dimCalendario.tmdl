		annotation SummarizationSetBy = Automatic

	partition dimCalendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(fatoPedidos[order_purchase_date]),
				        MAX(fatoPedidos[order_purchase_date])
				    ),
				    "Mês Número", MONTH([Date]),
				    "Mês", FORMAT([Date], "MMM"),
				    "AnoMês", FORMAT([Date], "YYYY-MM"),
				    "Ano", YEAR([Date])
				)

	annotation PBI_Id = a0212286e580470faab3d73a5c533426

